# Supabase edge function secrets.
# Copy to .env (gitignored) and set with: supabase secrets set --env-file .env

# Supabase project URL + secret key (Project Settings -> API / Secrets).
SUPABASE_URL=YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Stripe keys (https://dashboard.stripe.com/apikeys) — use test keys while developing.
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe webhook signing secret (https://dashboard.stripe.com/webhooks).
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public base URL of the storefront; Stripe success/cancel redirects use this.
SITE_URL=http://localhost:4200
# Random 32+ byte secret used to derive order confirmation tokens (generate with `openssl rand -hex 32`).
# If unset, the service role key is used as a fallback; set it explicitly in production.
ORDER_CONFIRMATION_SECRET=replace-with-a-long-random-string
